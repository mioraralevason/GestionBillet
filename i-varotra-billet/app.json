{
  "expo": {
    "name": "iBillet",
    "slug": "i-varotra-billet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_iBillet.png",
    "scheme": "ivarotrabillet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ivarotra.billet"
    },
    "android": {
      "package": "com.ralevasonmiora.ivarotrabillet",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo_iBillet.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableShrinkResources": false,
            "androidJsBundleLoader": "normal",
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.swmansion.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.google.android.gms.internal.** { *; }\n-keep class com.facebook.imagepipeline.** { *; }",
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_iBillet.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "L'accès à la caméra est nécessaire pour scanner les QR codes des billets.",
          "microphonePermission": "L'accès au microphone n'est pas utilisé mais requis par le plugin."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'accès à la galerie est nécessaire pour sélectionner les images des événements.",
          "cameraPermission": "L'accès à la caméra est nécessaire pour prendre des photos d'événements."
        }
      ],
      "expo-file-system",
      "expo-system-ui",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f03b46b0-40c0-4682-8e6c-54bbbf739891"
      }
    },
    "owner": "ralevasonmiora"
  }
}
